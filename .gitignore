*.log
logs/*
*.out
*.pid
*.pid.lock

# Secrets and local environment configuration
.env
.env.local
*.env.*
!.env.example
*.secret
*.secrets
secrets/

# Local configuration overrides
config/*.local.yaml
config/*.local.yml
config/*-local.yaml
config/*-local.yml

