!.vscode/extensions.json
*.swp
*.swo
*~

# Operating system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.orig
*.rej

# Keep empty runtime directories discoverable when needed
!.gitkeep