models/*
*.bin
*.onnx
*.safetensors
*.gguf
*.dll
*.so
*.dylib
*.exe

# Local databases and application state
*.db
*.sqlite
*.sqlite3
instance/
.cache/

# Build and distribution output
*.egg-info/
dist/
build/
wheelhouse/
pip-wheel-metadata/

# IDE and editor metadata
.idea/
.vscode/*
